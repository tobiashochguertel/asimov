{
    "name": "tobiashochguertel/asimov",
    "description": "Automatically exclude development dependencies from Apple Time Machine backups (Fork of stevegrunwell/asimov with optimized ZSH version)",
    "type": "project",
    "keywords": [
        "macos",
        "time-machine",
        "backup",
        "node_modules",
        "developer-tools",
        "tmutil"
    ],
    "authors": [
        {
            "name": "Steve Grunwell",
            "homepage": "https://stevegrunwell.com",
            "role": "Original Author"
        },
        {
            "name": "Sudar Muthu",
            "homepage": "https://sudarmuthu.com",
            "role": "Original Contributor"
        },
        {
            "name": "Tobias Hochguerel",
            "email": "tobias.hochguertel@googlemail.com",
            "homepage": "https://github.com/tobiashochguertel",
            "role": "Fork Maintainer"
        }
    ],
    "support": {
        "source": "https://github.com/tobiashochguertel/asimov",
        "issues": "https://github.com/tobiashochguertel/asimov/issues"
    },
    "license": "MIT",
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5|^9.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
      "test": "sh tests/bin/run-tests.sh",
      "test:zsh": "zsh -n asimov-zsh && ASIMOV_DRY_RUN=true ./asimov-zsh"
    },
    "scripts-descriptions": {
      "test": "Run the automated tests for Asimov (bash version).",
      "test:zsh": "Run syntax check and dry-run test for asimov-zsh."
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
