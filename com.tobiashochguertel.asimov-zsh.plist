<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.tobiashochguertel.asimov-zsh</string>
        <key>Program</key>
        <string>/usr/local/bin/asimov</string>
        <key>StartInterval</key>
        <!-- 24 hours = 60 * 60 * 24 -->
        <integer>86400</integer>
        <key>EnvironmentVariables</key>
        <dict>
            <!-- 
                Note: ~ is expanded to $HOME by asimov-zsh script.
                launchd does NOT expand ~ or $HOME in environment variables.
            -->
            
            <!-- Enable caching for faster subsequent runs -->
            <key>ASIMOV_OPT_CACHE</key>
            <string>true</string>
            
            <!-- Use SQLite for O(log n) indexed lookups (recommended for 100,000+ exclusions) -->
            <key>ASIMOV_OPT_SQLITE</key>
            <string>true</string>
            <key>ASIMOV_SQLITE_DB</key>
            <string>~/.cache/asimov.db</string>
            
            <!-- Enable batch operations for better performance -->
            <key>ASIMOV_OPT_BATCH</key>
            <string>true</string>
            <key>ASIMOV_OPT_BATCH_SIZE</key>
            <string>50</string>
            
            <!-- Skip size calculation for speed -->
            <key>ASIMOV_OPT_SKIP_SIZE</key>
            <string>true</string>
            
            <!-- Enable JSON logging -->
            <key>ASIMOV_LOG_FILE</key>
            <string>~/.local/log/asimov.log</string>
            <key>ASIMOV_LOG_FORMAT</key>
            <string>json</string>
        </dict>
    </dict>
</plist>
