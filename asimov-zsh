#!/usr/bin/env zsh
# -*- mode: zsh; sh-indentation: 4; indent-tabs-mode: nil; sh-basic-offset: 4; -*-

# Optimized Asimov script using ZSH builtins and fd for faster filesystem search
#
# Look through the local filesystem and exclude development dependencies
# from Apple Time Machine backups.
#
# Performance improvements over bash version:
# - Uses ZSH builtins instead of external tools where possible
# - Uses `fd` for parallel filesystem search (much faster than find)
# - ZSH native string manipulation instead of external cut/grep
# - Uses zsh/stat module for faster file operations
#
# @version 0.7.0
# @author  Steve Grunwell (Original Author)
# @author  Tobias Hochguerel <tobias.hochguertel@googlemail.com> (Fork Maintainer)
# @license MIT

# Enable strict mode
setopt ERR_EXIT NO_UNSET PIPE_FAIL

# Load ZSH modules for performance
zmodload zsh/stat 2>/dev/null || true
zmodload zsh/datetime 2>/dev/null || true
zmodload zsh/parameter 2>/dev/null || true
zmodload zsh/zutil 2>/dev/null || true

# =============================================================================
# Configuration - Centralized associative array with sensible defaults
# =============================================================================
# All configuration is stored in ASIMOV_CONFIG associative array.
# Environment variables override defaults. Access via: ${ASIMOV_CONFIG[key]}
#
# Keys:
#   root              - Root directory to scan (default: $HOME)
#   skip_trash        - Skip ~/.Trash (default: true)
#   skip_library      - Skip ~/Library (default: true)
#   dry_run           - Don't actually exclude, just print (default: false)
#   verbose           - Print extra debug info (default: false)
#   list_exclusions   - List current exclusions instead of scanning (default: false)
#   init_cache        - Initialize cache from current exclusions (default: false)
#   opt_cache         - Enable exclusion status caching (default: false)
#   opt_cache_file    - Cache file location (default: ~/.cache/asimov-exclusions)
#   opt_incremental   - Only scan recently modified dirs (default: false)
#   opt_incremental_days - Days for incremental scan (default: 7)
#   opt_parallel      - Enable parallel tmutil calls (default: false)
#   opt_parallel_jobs - Max parallel jobs (default: 4)
#   opt_gitignore     - Use fd's gitignore awareness (default: false)
#   opt_dust          - Use dust instead of du for size (default: false)
#   opt_skip_size     - Skip size calculation entirely (default: false)
#   opt_mmap          - Use in-memory hash for cache lookups (default: false)
#   opt_batch         - Enable batch operations for tmutil and du (default: false)
#   opt_batch_size    - Number of paths per batch (default: 50)
# =============================================================================

typeset -A ASIMOV_CONFIG=(
    [root]="${ASIMOV_ROOT:-$HOME}"
    [skip_trash]="${ASIMOV_SKIP_TRASH:-true}"
    [skip_library]="${ASIMOV_SKIP_LIBRARY:-true}"
    [dry_run]="${ASIMOV_DRY_RUN:-false}"
    [verbose]="${ASIMOV_VERBOSE:-false}"
    [list_exclusions]="${ASIMOV_LIST_EXCLUSIONS:-false}"
    [init_cache]="${ASIMOV_INIT_CACHE:-false}"
    [opt_cache]="${ASIMOV_OPT_CACHE:-false}"
    [opt_cache_file]="${ASIMOV_CACHE_FILE:-${HOME}/.cache/asimov-exclusions}"
    [opt_incremental]="${ASIMOV_OPT_INCREMENTAL:-false}"
    [opt_incremental_days]="${ASIMOV_OPT_INCREMENTAL_DAYS:-7}"
    [opt_parallel]="${ASIMOV_OPT_PARALLEL:-false}"
    [opt_parallel_jobs]="${ASIMOV_OPT_PARALLEL_JOBS:-4}"
    [opt_gitignore]="${ASIMOV_OPT_GITIGNORE:-false}"
    [opt_dust]="${ASIMOV_OPT_DUST:-false}"
    [opt_skip_size]="${ASIMOV_OPT_SKIP_SIZE:-false}"
    [opt_mmap]="${ASIMOV_OPT_MMAP:-false}"
    [opt_batch]="${ASIMOV_OPT_BATCH:-false}"
    [opt_batch_size]="${ASIMOV_OPT_BATCH_SIZE:-50}"
)

# =============================================================================
# List Exclusions Mode - Uses mdfind for comprehensive listing
# =============================================================================
list_current_exclusions() {
    print "\033[0;36mRetrieving current Time Machine exclusions...\033[0m\n"
    
    local root_filter="${ASIMOV_CONFIG[root]}"
    local total_count
    local filtered_count
    
    # Get all exclusions using mdfind (most comprehensive method)
    # Note: sudo provides complete results, but works without for user-accessible paths
    local all_exclusions
    all_exclusions=$(mdfind "com_apple_backup_excludeItem = 'com.apple.backupd'" 2>/dev/null)
    
    total_count=$(echo "$all_exclusions" | wc -l | tr -d ' ')
    
    print "\033[0;35mTotal Time Machine exclusions: $total_count\033[0m"
    
    if [[ -n "$root_filter" ]]; then
        local filtered
        filtered=$(echo "$all_exclusions" | grep "^$root_filter" 2>/dev/null)
        filtered_count=$(echo "$filtered" | grep -c . 2>/dev/null || echo "0")
        
        print "\033[0;35mExclusions in $root_filter: $filtered_count\033[0m\n"
        
        if [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]]; then
            # Show by type
            local node_modules_count=$(echo "$filtered" | grep -c "node_modules" || true)
            local target_count=$(echo "$filtered" | grep -c "/target$" || true)
            local venv_count=$(echo "$filtered" | grep -cE "\.venv$|/venv$" || true)
            local vendor_count=$(echo "$filtered" | grep -c "/vendor$" || true)
            
            print "  node_modules: $node_modules_count"
            print "  target:       $target_count"
            print "  .venv/venv:   $venv_count"
            print "  vendor:       $vendor_count"
            print ""
        fi
        
        echo "$filtered"
    else
        echo "$all_exclusions"
    fi
}

# =============================================================================
# Initialize Cache Mode - Populate cache from current exclusions
# =============================================================================
init_cache_from_exclusions() {
    print "\033[0;36mInitializing cache from current Time Machine exclusions...\033[0m\n"
    
    mkdir -p "${ASIMOV_CONFIG[opt_cache_file]:h}" 2>/dev/null || true
    
    # Get exclusions filtered by root
    local exclusions
    exclusions=$(mdfind "com_apple_backup_excludeItem = 'com.apple.backupd'" 2>/dev/null | grep "^${ASIMOV_CONFIG[root]}" 2>/dev/null)
    
    local count=$(echo "$exclusions" | grep -c . 2>/dev/null || echo "0")
    
    # Write to cache file
    echo "$exclusions" > "${ASIMOV_CONFIG[opt_cache_file]}"
    
    print "\033[0;32mCache initialized with $count exclusions\033[0m"
    print "Cache file: ${ASIMOV_CONFIG[opt_cache_file]}"
}

# Handle special modes before main execution
if [[ "${ASIMOV_CONFIG[list_exclusions]}" == "true" ]]; then
    list_current_exclusions
    exit 0
fi

if [[ "${ASIMOV_CONFIG[init_cache]}" == "true" ]]; then
    init_cache_from_exclusions
    exit 0
fi

# =============================================================================
# Main Script Variables
# =============================================================================

# OPT 5: In-memory hash cache for O(1) lookups
typeset -A MMAP_CACHE=()
typeset -a MMAP_NEW_ENTRIES=()

# Initialize cache
if [[ "${ASIMOV_CONFIG[opt_cache]}" == "true" ]]; then
    mkdir -p "${ASIMOV_CONFIG[opt_cache_file]:h}" 2>/dev/null || true
    touch "${ASIMOV_CONFIG[opt_cache_file]}" 2>/dev/null || true
    
    # OPT 5: Load cache into memory for fast lookups
    if [[ "${ASIMOV_CONFIG[opt_mmap]}" == "true" ]] && [[ -f "${ASIMOV_CONFIG[opt_cache_file]}" ]]; then
        while IFS= read -r cached_path; do
            [[ -n "$cached_path" ]] && MMAP_CACHE[$cached_path]=1
        done < "${ASIMOV_CONFIG[opt_cache_file]}"
        [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "Loaded ${#MMAP_CACHE[@]} entries into memory cache"
    fi
fi

# Parallel job tracking
typeset -a PARALLEL_PIDS=()

# Paths to unconditionally skip over (configurable via config)
typeset -a ASIMOV_SKIP_PATHS=()
[[ "${ASIMOV_CONFIG[skip_trash]}" == "true" ]] && ASIMOV_SKIP_PATHS+=(~/.Trash)
[[ "${ASIMOV_CONFIG[skip_library]}" == "true" ]] && ASIMOV_SKIP_PATHS+=(~/Library)
readonly -a ASIMOV_SKIP_PATHS

# A list of "directory"/"sentinel" pairs.
# Directories will only be excluded if the dependency ("sentinel") file exists.
readonly -a ASIMOV_VENDOR_DIR_SENTINELS=(
    '.build Package.swift'
    '.gradle build.gradle'
    '.gradle build.gradle.kts'
    'build build.gradle'
    'build build.gradle.kts'
    '.dart_tool pubspec.yaml'
    '.packages pubspec.yaml'
    '.stack-work stack.yaml'
    '.tox tox.ini'
    '.nox noxfile.py'
    '.vagrant Vagrantfile'
    '.venv requirements.txt'
    '.venv pyproject.toml'
    'Carthage Cartfile'
    'Pods Podfile'
    'bower_components bower.json'
    'build build.gradle'
    'build build.gradle.kts'
    'build pubspec.yaml'
    'build setup.py'
    'dist setup.py'
    'node_modules package.json'
    '.parcel-cache package.json'
    'target Cargo.toml'
    'target pom.xml'
    'target build.sbt'
    'target plugins.sbt'
    'vendor composer.json'
    'vendor Gemfile'
    'vendor go.mod'
    'venv requirements.txt'
    'deps mix.exs'
    '.build mix.exs'
    '.terraform.d .terraformrc'
    '.terragrunt-cache terragrunt.hcl'
    'cdk.out cdk.json'
)

# Extract unique directory names to search for
typeset -a VENDOR_DIRS
typeset -A SENTINEL_MAP

for pair in "${ASIMOV_VENDOR_DIR_SENTINELS[@]}"; do
    # ZSH native word splitting
    local dir_name="${pair%% *}"
    local sentinel="${pair#* }"
    
    # Add to unique dirs list (use (I) instead of (r) to avoid unset error)
    if (( ! ${VENDOR_DIRS[(I)$dir_name]} )); then
        VENDOR_DIRS+=("$dir_name")
    fi
    
    # Map: dir_name -> list of possible sentinels (space-separated)
    if [[ -n "${SENTINEL_MAP[$dir_name]:-}" ]]; then
        SENTINEL_MAP[$dir_name]+=" $sentinel"
    else
        SENTINEL_MAP[$dir_name]="$sentinel"
    fi
done

# Build exclusion patterns for fd
typeset -a FD_EXCLUDE_ARGS
for skip in "${ASIMOV_SKIP_PATHS[@]}"; do
    FD_EXCLUDE_ARGS+=(--exclude "${skip:t}")
done

# Check if path has any valid sentinel file
has_sentinel() {
    local dir_path="$1"
    local dir_name="${dir_path:t}"
    local parent_dir="${dir_path:h}"
    local sentinels="${SENTINEL_MAP[$dir_name]}"
    
    # ZSH native: split sentinels and check each
    for sentinel in ${(s: :)sentinels}; do
        if [[ -e "$parent_dir/$sentinel" ]]; then
            return 0
        fi
    done
    return 1
}

# OPT 1 & 5: Check cache for already-excluded paths
is_cached_exclusion() {
    local dir_path="$1"
    
    if [[ "${ASIMOV_CONFIG[opt_cache]}" != "true" ]]; then
        return 1
    fi
    
    # OPT 5: Use in-memory hash for O(1) lookup
    if [[ "${ASIMOV_CONFIG[opt_mmap]}" == "true" ]]; then
        if [[ -n "${MMAP_CACHE[$dir_path]:-}" ]]; then
            [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "- $dir_path found in memory cache, skipping."
            return 0
        fi
        return 1
    fi
    
    # Fallback: grep file (slower, O(n))
    if [[ -f "${ASIMOV_CONFIG[opt_cache_file]}" ]] && grep -qF "$dir_path" "${ASIMOV_CONFIG[opt_cache_file]}" 2>/dev/null; then
        [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "- $dir_path found in file cache, skipping."
        return 0
    fi
    return 1
}

# OPT 1 & 5: Add path to exclusion cache
add_to_cache() {
    local dir_path="$1"
    
    if [[ "${ASIMOV_CONFIG[opt_cache]}" != "true" ]]; then
        return
    fi
    
    # OPT 5: Add to in-memory hash and batch for later write
    if [[ "${ASIMOV_CONFIG[opt_mmap]}" == "true" ]]; then
        MMAP_CACHE[$dir_path]=1
        MMAP_NEW_ENTRIES+=("$dir_path")
    else
        # Direct file append (slower)
        print -- "$dir_path" >> "${ASIMOV_CONFIG[opt_cache_file]}"
    fi
}

# OPT 5: Flush in-memory cache to disk (called at end)
flush_mmap_cache() {
    if [[ "${ASIMOV_CONFIG[opt_mmap]}" == "true" ]] && (( ${#MMAP_NEW_ENTRIES[@]} > 0 )); then
        printf '%s\n' "${MMAP_NEW_ENTRIES[@]}" >> "${ASIMOV_CONFIG[opt_cache_file]}"
        [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "\nFlushed ${#MMAP_NEW_ENTRIES[@]} new entries to cache file"
    fi
}

# =============================================================================
# Batch Operations (OPT 7)
# =============================================================================

# Batch check exclusion status for multiple paths
# Populates BATCH_EXCLUDED_MAP with path -> "excluded" or "included"
typeset -A BATCH_EXCLUDED_MAP=()

batch_check_exclusions() {
    local -a paths=("$@")
    
    if (( ${#paths[@]} == 0 )); then
        return
    fi
    
    # Run tmutil isexcluded on all paths at once
    local output
    output=$(tmutil isexcluded "${paths[@]}" 2>/dev/null) || true
    
    # Parse output: each line is "[Excluded] path" or "[Included] path"
    while IFS= read -r line; do
        if [[ "$line" == "[Excluded]"* ]]; then
            local path="${line#\[Excluded\]	}"
            BATCH_EXCLUDED_MAP[$path]="excluded"
        elif [[ "$line" == "[Included]"* ]]; then
            local path="${line#\[Included\]	}"
            BATCH_EXCLUDED_MAP[$path]="included"
        fi
    done <<< "$output"
}

# Batch calculate sizes for multiple paths
# Populates BATCH_SIZE_MAP with path -> size string
typeset -A BATCH_SIZE_MAP=()

batch_get_sizes() {
    local -a paths=("$@")
    
    if (( ${#paths[@]} == 0 )) || [[ "${ASIMOV_CONFIG[opt_skip_size]}" == "true" ]]; then
        return
    fi
    
    local output
    if [[ "${ASIMOV_CONFIG[opt_dust]}" == "true" ]] && command -v dust &>/dev/null; then
        # dust doesn't support multiple paths in a simple way, fall back to du
        output=$(du -hs "${paths[@]}" 2>/dev/null) || true
    else
        output=$(du -hs "${paths[@]}" 2>/dev/null) || true
    fi
    
    # Parse output: each line is "SIZE\tPATH"
    while IFS=$'\t' read -r size path; do
        if [[ -n "$path" ]]; then
            BATCH_SIZE_MAP[$path]="$size"
        fi
    done <<< "$output"
}

# Process a batch of paths - check exclusions and sizes, then exclude
process_batch() {
    local -a paths=("$@")
    
    if (( ${#paths[@]} == 0 )); then
        return
    fi
    
    [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "Processing batch of ${#paths[@]} paths..."
    
    # Filter out cached paths first
    local -a uncached_paths=()
    for path in "${paths[@]}"; do
        if ! is_cached_exclusion "$path"; then
            uncached_paths+=("$path")
        fi
    done
    
    if (( ${#uncached_paths[@]} == 0 )); then
        return
    fi
    
    # Batch check exclusion status
    batch_check_exclusions "${uncached_paths[@]}"
    
    # Find paths that need to be excluded
    local -a to_exclude=()
    for path in "${uncached_paths[@]}"; do
        if [[ "${BATCH_EXCLUDED_MAP[$path]:-}" == "excluded" ]]; then
            [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "- $path is already excluded, skipping."
            add_to_cache "$path"
        else
            to_exclude+=("$path")
        fi
    done
    
    if (( ${#to_exclude[@]} == 0 )); then
        return
    fi
    
    # Batch get sizes for paths to exclude
    batch_get_sizes "${to_exclude[@]}"
    
    # Exclude each path
    for path in "${to_exclude[@]}"; do
        local size="${BATCH_SIZE_MAP[$path]:-N/A}"
        
        if [[ "${ASIMOV_CONFIG[dry_run]}" == "true" ]]; then
            print -- "[DRY-RUN] Would exclude: $path ($size)"
        else
            tmutil addexclusion "$path"
            print -- "- $path has been excluded from Time Machine backups ($size)."
            add_to_cache "$path"
        fi
    done
    
    # Clear batch maps for next batch
    BATCH_EXCLUDED_MAP=()
    BATCH_SIZE_MAP=()
}

# OPT 6: Get directory size using configured method
get_dir_size() {
    local dir_path="$1"
    
    if [[ "${ASIMOV_CONFIG[opt_skip_size]}" == "true" ]]; then
        print "N/A"
        return
    fi
    
    if [[ "${ASIMOV_CONFIG[opt_dust]}" == "true" ]] && command -v dust &>/dev/null; then
        # Use dust for faster size calculation
        dust -d 0 -b "$dir_path" 2>/dev/null | tail -1 | awk '{print $1}'
    else
        # Use du (default)
        du -hs "$dir_path" 2>/dev/null | cut -f1
    fi
}

# OPT 3: Wait for parallel jobs to complete
wait_for_parallel_jobs() {
    if [[ "${ASIMOV_CONFIG[opt_parallel]}" == "true" ]] && (( ${#PARALLEL_PIDS[@]} > 0 )); then
        for pid in "${PARALLEL_PIDS[@]}"; do
            wait "$pid" 2>/dev/null || true
        done
        PARALLEL_PIDS=()
    fi
}

# OPT 3: Manage parallel job pool
manage_parallel_pool() {
    if [[ "${ASIMOV_CONFIG[opt_parallel]}" == "true" ]]; then
        # Wait if we've hit the job limit
        while (( ${#PARALLEL_PIDS[@]} >= ${ASIMOV_CONFIG[opt_parallel_jobs]} )); do
            # Remove completed jobs
            typeset -a new_pids=()
            for pid in "${PARALLEL_PIDS[@]}"; do
                if kill -0 "$pid" 2>/dev/null; then
                    new_pids+=("$pid")
                fi
            done
            PARALLEL_PIDS=("${new_pids[@]}")
            
            if (( ${#PARALLEL_PIDS[@]} >= ${ASIMOV_CONFIG[opt_parallel_jobs]} )); then
                sleep 0.1
            fi
        done
    fi
}

# Exclude the given path from Time Machine backups using ZSH builtins
exclude_path() {
    local dir_path="$1"
    
    # OPT 1: Check cache first
    if is_cached_exclusion "$dir_path"; then
        return
    fi
    
    # Check if already excluded using ZSH pattern matching
    local status_output
    status_output=$(tmutil isexcluded "$dir_path" 2>/dev/null)
    
    if [[ "$status_output" == *"[Excluded]"* ]]; then
        [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && print -- "- $dir_path is already excluded, skipping."
        # OPT 1: Add to cache
        add_to_cache "$dir_path"
        return
    fi
    
    # OPT 6: Get size using configured method
    local sizeondisk
    sizeondisk=$(get_dir_size "$dir_path")
    
    if [[ "${ASIMOV_CONFIG[dry_run]}" == "true" ]]; then
        print -- "[DRY-RUN] Would exclude: $dir_path ($sizeondisk)"
    else
        tmutil addexclusion "$dir_path"
        print -- "- $dir_path has been excluded from Time Machine backups ($sizeondisk)."
        # OPT 1: Add to cache
        add_to_cache "$dir_path"
    fi
}

# OPT 3: Parallel version of exclude_path
exclude_path_parallel() {
    local dir_path="$1"
    
    if [[ "${ASIMOV_CONFIG[opt_parallel]}" == "true" ]]; then
        manage_parallel_pool
        exclude_path "$dir_path" &
        PARALLEL_PIDS+=($!)
    else
        exclude_path "$dir_path"
    fi
}

# Print configuration status
print_config() {
    print "\n\033[0;36mFinding dependency directories in ${ASIMOV_CONFIG[root]}…\033[0m"
    [[ "${ASIMOV_CONFIG[dry_run]}" == "true" ]] && print "\033[0;33m[DRY-RUN MODE - no changes will be made]\033[0m"
    
    if [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]]; then
        print "\033[0;35mOptimizations enabled:\033[0m"
        [[ "${ASIMOV_CONFIG[opt_cache]}" == "true" ]] && print "  - Caching (OPT 1): ${ASIMOV_CONFIG[opt_cache_file]}"
        [[ "${ASIMOV_CONFIG[opt_incremental]}" == "true" ]] && print "  - Incremental scan (OPT 2): ${ASIMOV_CONFIG[opt_incremental_days]} days"
        [[ "${ASIMOV_CONFIG[opt_parallel]}" == "true" ]] && print "  - Parallel tmutil (OPT 3): ${ASIMOV_CONFIG[opt_parallel_jobs]} jobs"
        [[ "${ASIMOV_CONFIG[opt_gitignore]}" == "true" ]] && print "  - Gitignore awareness (OPT 4)"
        [[ "${ASIMOV_CONFIG[opt_mmap]}" == "true" ]] && print "  - Memory-mapped cache (OPT 5): ${#MMAP_CACHE[@]} entries loaded"
        [[ "${ASIMOV_CONFIG[opt_dust]}" == "true" ]] && print "  - Using dust for size (OPT 6)"
        [[ "${ASIMOV_CONFIG[opt_skip_size]}" == "true" ]] && print "  - Skip size calculation (OPT 6)"
        [[ "${ASIMOV_CONFIG[opt_batch]}" == "true" ]] && print "  - Batch operations (OPT 7): batch size ${ASIMOV_CONFIG[opt_batch_size]}"
    fi
}

print_config

# Build fd regex pattern for directory names
typeset fd_pattern
fd_pattern="^(${(j:|:)VENDOR_DIRS})\$"

# Build fd arguments based on optimizations
typeset -a fd_args=(
    --type d
    --hidden
)

# OPT 4: Use gitignore awareness or not
if [[ "${ASIMOV_CONFIG[opt_gitignore]}" != "true" ]]; then
    fd_args+=(--no-ignore)
fi

# OPT 2: Incremental scanning
if [[ "${ASIMOV_CONFIG[opt_incremental]}" == "true" ]]; then
    fd_args+=(--changed-within "${ASIMOV_CONFIG[opt_incremental_days]}d")
fi

# Add exclusion patterns
fd_args+=("${FD_EXCLUDE_ARGS[@]}")

# OPT 7: Batch mode - collect paths and process in batches
if [[ "${ASIMOV_CONFIG[opt_batch]}" == "true" ]]; then
    typeset -a batch_paths=()
    typeset -a all_valid_paths=()
    
    # First collect all valid paths (fd output piped to while runs in subshell, so collect first)
    while IFS= read -r found_path; do
        if has_sentinel "$found_path"; then
            all_valid_paths+=("$found_path")
        fi
    done < <(fd "${fd_args[@]}" "$fd_pattern" "${ASIMOV_CONFIG[root]}" 2>/dev/null)
    
    # Process paths in batches
    for path in "${all_valid_paths[@]}"; do
        batch_paths+=("$path")
        
        # Process batch when it reaches the configured size
        if (( ${#batch_paths[@]} >= ${ASIMOV_CONFIG[opt_batch_size]} )); then
            process_batch "${batch_paths[@]}"
            batch_paths=()
        fi
    done
    
    # Process remaining paths in the final batch
    if (( ${#batch_paths[@]} > 0 )); then
        process_batch "${batch_paths[@]}"
    fi
else
    # Non-batch mode: process paths individually (original behavior)
    fd "${fd_args[@]}" "$fd_pattern" "${ASIMOV_CONFIG[root]}" 2>/dev/null | while IFS= read -r found_path; do
        if has_sentinel "$found_path"; then
            exclude_path_parallel "$found_path"
        fi
    done
    
    # OPT 3: Wait for all parallel jobs to complete
    wait_for_parallel_jobs
fi

# OPT 5: Flush in-memory cache to disk
flush_mmap_cache

# Print cache statistics if verbose and caching enabled
if [[ "${ASIMOV_CONFIG[verbose]}" == "true" ]] && [[ "${ASIMOV_CONFIG[opt_cache]}" == "true" ]] && [[ -f "${ASIMOV_CONFIG[opt_cache_file]}" ]]; then
    local cache_count
    cache_count=$(wc -l < "${ASIMOV_CONFIG[opt_cache_file]}" | tr -d ' ')
    print "\n\033[0;35mCache statistics: $cache_count entries in ${ASIMOV_CONFIG[opt_cache_file]}\033[0m"
fi
